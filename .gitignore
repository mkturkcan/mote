# ── large model weights, fetched by scripts/install.sh (or scripts/dl_quants.py) ──
models/
*.gguf

# ── cmake / build artifacts (regenerated by pi_build.sh / install.sh) ──
build/
build-*/
build-pi/
third_party/llama.cpp/build*/
_deps/
*.o
*.a
*.so
*.so.*
*.dylib

# ── large regenerable data dumps (kernel activation captures) ──
kernels/data/*.f32
kernels/data/*.bin
*.npy

# ── release tarballs produced by scripts/package_release.sh ──
dist/
*.tar.gz

# ── private engineering log + HuggingFace upload staging (kept out of the public repo) ──
PLAN.md
huggingface/

# ── python / editor / OS noise ──
__pycache__/
*.pyc
.venv/
.vscode/
.idea/
.DS_Store
*.swp

# ── the vendored llama.cpp is committed as plain source (its nested .git was removed; see ──
# ── third_party/llama.cpp/MOTE.md). this guard keeps any re-clone's git metadata out. ──
third_party/llama.cpp/.git/
