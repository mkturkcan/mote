+                    const float draft_logit = logits[draft[i]];
+                    float max_logit = logits[0];
+                    int   rank = 0; // # tokens strictly more probable than the draft token
+                    for (int v = 0; v < n_vocab; ++v) {
+                        const float lv = logits[v];
+                        if (lv > max_logit)   { max_logit = lv; }
+                        if (lv > draft_logit) { ++rank; if (rank >= acc_topk) break; } // early out: not in top-K
+                    }
+                    if (rank < acc_topk && expf(draft_logit - max_logit) >= acc_pratio) {
+                        id = draft[i]; // accept the high-prob draft token instead of the argmax
+                    }
+                }
+            }
+        }
 
