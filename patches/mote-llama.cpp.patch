+// ---- per-op-type profiling (env GGML_OP_PROFILE=1), thread-0 wall time between barriers ----
+static int64_t g_opprof_us[GGML_OP_COUNT];
+static int64_t g_opprof_cnt[GGML_OP_COUNT];
+static int64_t g_opprof_mulmat_q[2];   // [0]=us [1]=count for MUL_MAT with quantized src0 (weight matmul)
+static int64_t g_opprof_fused_us;
+static int64_t g_opprof_fused_cnt;
+static int     g_opprof_enabled = -1;
+static int64_t g_opprof_ncompute = 0;
+static int64_t g_opprof_skip = 0;
+
+void ggml_opprof_dump(void) {
+    if (g_opprof_enabled != 1) return;
+    int64_t total = 0;
+    for (int i = 0; i < GGML_OP_COUNT; i++) total += g_opprof_us[i];
+    total += g_opprof_fused_us;
+    fprintf(stderr, "\n==== GGML OP PROFILE (thread-0 wall, us) over %lld graph-computes (after skipping %lld) ====\n",
+            (long long)(g_opprof_ncompute - g_opprof_skip), (long long)g_opprof_skip);
+    fprintf(stderr, "%-22s %12s %10s %8s\n", "op", "us", "count", "%%");
+    // print MUL_MAT split out
+    for (int i = 0; i < GGML_OP_COUNT; i++) {
+        if (g_opprof_cnt[i] == 0) continue;
+        if (i == GGML_OP_MUL_MAT) {
+            int64_t q_us = g_opprof_mulmat_q[0], q_cnt = g_opprof_mulmat_q[1];
+            int64_t f_us = g_opprof_us[i] - q_us, f_cnt = g_opprof_cnt[i] - q_cnt;
+            fprintf(stderr, "%-22s %12lld %10lld %7.2f\n", "MUL_MAT(weight/q)", (long long)q_us, (long long)q_cnt, total? 100.0*q_us/total:0);
+            fprintf(stderr, "%-22s %12lld %10lld %7.2f\n", "MUL_MAT(f32/other)", (long long)f_us, (long long)f_cnt, total? 100.0*f_us/total:0);
+            continue;
+        }
+        fprintf(stderr, "%-22s %12lld %10lld %7.2f\n", ggml_op_name((enum ggml_op)i),
+                (long long)g_opprof_us[i], (long long)g_opprof_cnt[i], total? 100.0*g_opprof_us[i]/total:0);
+    }
