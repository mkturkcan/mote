+// Hand-written NEON+dotprod q3_K repacked gemv (8 cols, blocklen=4). BW-bound on Cortex-A76 (llvm-mca
+// ~497 cyc/superblock). Identity: q3_K weight = (3-bit value 0..7) - 4 -> dot the unsigned value, subtract
+// the 4*Σ scale*bsum bias (q8 bsums). Scales are pre-unpacked SIGNED & interleaved at repack time.
+// Bit-exact vs ggml_vec_dot_q3_K_q8_K (validated under qemu-aarch64, kernels/q3neon.c, 0/9600).
+void ggml_gemv_q3_K_8x4_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK_K;
+    const int nb = n / qk;
+    constexpr int ncols_interleaved = 8;
+
+    assert(n % qk == 0);
+    assert(nc % ncols_interleaved == 0);
+
+    UNUSED(bs);
+    UNUSED(nr);
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    // qgroup table {qbyte0, hbyte0, base_bit, sb_base}; for shift index s: sb=sb_base+2s, shift=2s, bit=base_bit+s
+    static const int QG[4][4] = { {0, 0, 0, 0}, {16, 16, 0, 1}, {32, 0, 4, 8}, {48, 16, 4, 9} };
+    const uint8x16_t m3 = vdupq_n_u8(3), m1 = vdupq_n_u8(1);
+
+    const block_q8_K * GGML_RESTRICT q8_ptr = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / ncols_interleaved; x++) {
+        const block_q3_Kx8 * GGML_RESTRICT b_ptr = (const block_q3_Kx8 *) vx + (x * nb);
+        float32x4_t acc_f32[2] = { vdupq_n_f32(0), vdupq_n_f32(0) };
+        for (int bb = 0; bb < nb; bb++) {
+            // unpack the 8 columns' packed 6-bit scales -> SIGNED int8 scbuf[sb*8+col] (= sc-32). Scalar;
+            // overlaps the NEON work on an out-of-order core (separate integer pipes).
+            int8_t scbuf[16 * 8];
+            {
+                const uint32_t kmask1 = 0x03030303, kmask2 = 0x0f0f0f0f;
+                for (int col = 0; col < 8; col++) {
+                    uint32_t auxs[4];
+                    memcpy(auxs, b_ptr[bb].scales + col * 12, 12);
+                    uint32_t tmp = auxs[2];
+                    auxs[2] = ((auxs[0] >> 4) & kmask2) | (((tmp >> 4) & kmask1) << 4);
+                    auxs[3] = ((auxs[1] >> 4) & kmask2) | (((tmp >> 6) & kmask1) << 4);
+                    auxs[0] = (auxs[0] & kmask2) | (((tmp >> 0) & kmask1) << 4);
+                    auxs[1] = (auxs[1] & kmask2) | (((tmp >> 2) & kmask1) << 4);
+                    const int8_t * s8 = (const int8_t *) auxs;
+                    for (int sb = 0; sb < 16; sb++) scbuf[sb * 8 + col] = (int8_t) (s8[sb] - 32);
+                }
+            }
+            float32x4_t q8d = vdupq_n_f32(q8_ptr[bb].d);
+            float32x4_t d0  = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr[bb].d)),     q8d);
+            float32x4_t d1  = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr[bb].d + 4)), q8d);
+            int32x4_t acc[2] = { vdupq_n_s32(0), vdupq_n_s32(0) };
+
+            // bias[col] = 4 * Σ_sb scale[sb][col] * bsum[sb]  (handles the constant -4 weight offset)
+            int32x4_t bias_lo = vdupq_n_s32(0), bias_hi = vdupq_n_s32(0);
+            for (int sb = 0; sb < 16; sb++) {
+                int16x8_t sc = vmovl_s8(vld1_s8(scbuf + sb * 8));
+                int16_t   bsm = q8_ptr[bb].bsums[sb];
+                bias_lo = vmlal_n_s16(bias_lo, vget_low_s16(sc),  bsm);
+                bias_hi = vmlal_n_s16(bias_hi, vget_high_s16(sc), bsm);
+            }
+            bias_lo = vshlq_n_s32(bias_lo, 2);
+            bias_hi = vshlq_n_s32(bias_hi, 2);
+
+            for (int qg = 0; qg < 4; qg++) {
+                const int qbyte0 = QG[qg][0], hbyte0 = QG[qg][1], base_bit = QG[qg][2], sb_base = QG[qg][3];
+                for (int g = 0; g < 2; g++) {
+                    int32x4_t sbacc[4] = { vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0) };
+                    for (int q = 0; q < 4; q++) {
+                        uint8x16_t qsv = vld1q_u8(b_ptr[bb].qs    + ((qbyte0 / 4 + q) * 8 + 4 * g) * 4);
+                        uint8x16_t hmv = vld1q_u8(b_ptr[bb].hmask + ((hbyte0 / 4 + q) * 8 + 4 * g) * 4);
+                        uint8x16_t hb  = vshlq_u8(hmv, vdupq_n_s8(-(int8_t) base_bit)); // bits -> positions 0..3
+                        const int8_t * q8b = q8_ptr[bb].qs + 4 * q;
+#define Q3_DEQDOT(S, SH, HBV) do { \
+            uint8x16_t lo = vandq_u8(vshrq_n_u8(qsv, (SH)), m3); \
+            int8x16_t w = vreinterpretq_s8_u8(vsliq_n_u8(lo, vandq_u8((HBV), m1), 2)); \
+            int8x16_t q8v = (int8x16_t) vld1q_dup_s32((const int32_t *) (q8b + (sb_base + 2 * (S)) * 16)); \
+            sbacc[(S)] = vdotq_s32(sbacc[(S)], w, q8v); \
+        } while (0)
+                        Q3_DEQDOT(0, 0, hb);
+                        Q3_DEQDOT(1, 2, vshrq_n_u8(hb, 1));
+                        Q3_DEQDOT(2, 4, vshrq_n_u8(hb, 2));
+                        Q3_DEQDOT(3, 6, vshrq_n_u8(hb, 3));
+#undef Q3_DEQDOT
+                    }
+                    for (int s2 = 0; s2 < 4; s2++) {
+                        const int sb = sb_base + 2 * s2;
+                        int32x4_t scv = vmovl_s16(vget_low_s16(vmovl_s8(vld1_s8(scbuf + sb * 8 + 4 * g))));
+                        acc[g] = vmlaq_s32(acc[g], sbacc[s2], scv);
+                    }
+                }
+            }
+            acc[0] = vsubq_s32(acc[0], bias_lo);
+            acc[1] = vsubq_s32(acc[1], bias_hi);
+            acc_f32[0] = vaddq_f32(acc_f32[0], vmulq_f32(vcvtq_f32_s32(acc[0]), d0));
+            acc_f32[1] = vaddq_f32(acc_f32[1], vmulq_f32(vcvtq_f32_s32(acc[1]), d1));
+        }
+        vst1q_f32(s + x * ncols_interleaved,     acc_f32[0]);
+        vst1q_f32(s + x * ncols_interleaved + 4, acc_f32[1]);
+    }
+    return;
+#endif  // defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    ggml_gemv_q3_K_8x4_q8_K_generic(n, s, bs, vx, vy, nr, nc);
+}
