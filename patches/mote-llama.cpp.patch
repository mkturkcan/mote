     GGML_ASSERT(idxs.size() == draft.size() + 1 && "idxs.size() must be draft.size() + 1");
 
     std::vector<llama_token> result;
     result.reserve(idxs.size());
 
+    const int   acc_topk   = spec_accept_topk();
+    const float acc_pratio = spec_accept_pratio();
