+// EXPERIMENTAL lossy-acceptance lever (env-gated, default OFF = exact/lossless):
+//   LLAMA_SPEC_ACCEPT_TOPK=K  -> accept a draft token (not just the argmax) if it is within the
+//     target's top-K candidates AND its prob >= LLAMA_SPEC_ACCEPT_PRATIO * top1_prob.
+//   This trades exact-distribution matching (quality) for more accepted tokens/pass (speed). The
+//   accepted token still comes from the target's high-probability set, so quality loss is bounded.
+static int   spec_accept_topk()   { const char* e=getenv("LLAMA_SPEC_ACCEPT_TOPK");   return e?atoi(e):0; }
+static float spec_accept_pratio() { const char* e=getenv("LLAMA_SPEC_ACCEPT_PRATIO"); return e?atof(e):0.0f; }
