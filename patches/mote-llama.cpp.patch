+        // lossy top-K acceptance: if the draft token isn't the argmax but is a high-prob target
+        // candidate, accept the DRAFT token (override id) and keep extending the run.
+        // NOTE: read the RAW target logits at idxs[i] directly — the greedy sampler chain collapses
+        // gsmpl->cur_p to the argmax (and may not softmax it), so common_sampler_get_candidates() is
+        // useless here at temperature 0. The prob ratio p(draft)/p(top1) == exp(logit_draft - logit_max)
+        // (the softmax normalizer cancels), so we never need an explicit softmax.
+        if (acc_topk > 1 && draft[i] != id) {
+            const float * logits = llama_get_logits_ith(ctx, idxs[i]);
+            if (logits != nullptr) {
+                const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
